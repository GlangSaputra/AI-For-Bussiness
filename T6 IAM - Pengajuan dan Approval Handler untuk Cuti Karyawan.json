    {
      "parameters": {
        "jsCode": "// 1. Ambil data dari Webhook (klik link email manager)\nconst webhookData = $('Webhook').first().json.query;\n\n// Jumlah hari cuti yang diminta\nconst daysRequested = parseInt(webhookData.days);\n\n// 2. Ambil data karyawan dari Google Sheets (node sebelumnya \"Cari Data Karyawan\")\nconst currentData = items[0].json;\n\n// Saldo cuti lama\nconst currentBalance = parseInt(currentData.Saldo_Cuti);\n\n// 3. Hitung saldo baru\nconst newBalance = currentBalance - daysRequested;\n\n// 4. Return data untuk node berikutnya (Update Saldo Cuti)\nreturn [{\n  json: {\n    ...currentData,        // bawa semua data lama (termasuk row_number, Email, Nama)\n    newBalance,            // saldo cuti terbaru\n    daysRequested,         // jumlah hari cuti yang dipotong\n    requestId: webhookData.id, // ID pengajuan unik\n    status: webhookData.status // approved/rejected\n  }\n}];\n"
      },
