    {
      "parameters": {
        "jsCode": "// Ambil semua baris dari Google Sheets\nlet filteredItems = items.filter(item => \n  !item.json.sentiment || \n  !item.json.category || \n  !item.json.action_plan\n);\n\n// Loop hanya baris yang lolos filter\nfor (const item of filteredItems) {\n  const feedbackText = item.json.feedback;\n\n  // Lewati baris jika feedback kosong\n  if (!feedbackText) continue;\n\n  // Buat Prompt Khusus\n  const prompt = `\n  Analyze this employee feedback in Indonesian: \"${feedbackText}\"\n\n  Tasks:\n  1. Determine sentiment (POSITIVE, NEUTRAL, NEGATIVE).\n  2. Categorize the issue (Facilities, Management, Salary, Workload, Training, Other).\n  3. Suggest a quick action (max 5 words).\n\n  You must output ONLY valid JSON in this format:\n  {\n    \"sentiment\": \"...\",\n    \"category\": \"...\",\n    \"action_plan\": \"...\"\n  }\n  `;\n\n  // Simpan prompt ke property baru 'ai_prompt'\n  item.json.ai_prompt = prompt;\n}\n\nreturn filteredItems;\n"
      },
