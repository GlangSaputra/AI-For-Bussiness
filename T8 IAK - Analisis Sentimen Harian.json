    {
      "parameters": {
        "jsCode": "const items = $items(\"Baca Data\");\n\nlet bullish = 0;\nlet bearish = 0;\nlet neutral = 0;\nlet total = 0;\n\nfor (const item of items) {\n  const sentiment = item.json.label; // kolom 'label' dari sheet\n\n  if (sentiment === 'BULLISH') {\n    bullish++;\n  } else if (sentiment === 'BEARISH') {\n    bearish++;\n  } else if (sentiment === 'NEUTRAL') {\n    neutral++;\n  }\n  total++;\n}\n\nreturn [\n  {\n    json: {\n      total_tweets: total,\n      bullish,\n      bearish,\n      neutral\n    }\n  }\n];\n"
      },
