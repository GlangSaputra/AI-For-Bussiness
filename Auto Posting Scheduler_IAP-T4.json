      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst postsToSend = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const dateStr = row['Scheduled Date'];\n  const timeStr = row['Scheduled Time'];\n  const status = row['Status'] || 'Pending'; // default\n\n  if (status === 'Pending' && dateStr && timeStr) {\n    const [day, month, year] = dateStr.split('/');\n    const dateTimeString = `${year}-${month}-${day}T${timeStr}`;\n    const scheduledTime = new Date(dateTimeString);\n\n    if (!isNaN(scheduledTime.getTime()) && scheduledTime <= now) {\n      postsToSend.push(item);\n    }\n  }\n}\n\nreturn postsToSend;\n"
      },
